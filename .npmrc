# The dependency tree has an upstream peer-dep conflict that npm's strict
# resolver rejects: `eslint-config-standard@17` (pulled by
# `@nextcloud/eslint-config@8`) wants `eslint-plugin-n@^15 || ^16`, but the
# project pins `eslint-plugin-n@^17`. This is pre-existing and not introduced
# by any single change. Use the legacy resolver so `npm install` AND `npm ci`
# (CI) resolve consistently. Revisit when the Nextcloud eslint config is bumped
# to a version that allows `eslint-plugin-n@^17`. See backlog TECH-LINT-006.
legacy-peer-deps=true
