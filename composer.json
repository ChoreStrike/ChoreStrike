{
    "name": "chorewars/chorewars",
    "description": "Gamified household task management for Nextcloud",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ChoreWars Contributors"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "nextcloud/coding-standard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\ChoreWars\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\ChoreWars\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "phpunit --configuration phpunit.xml"
    }
}
