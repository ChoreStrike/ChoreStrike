{
    "name": "chorestrike/chorestrike",
    "description": "Gamified household task management for Nextcloud",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ChoreStrike Contributors"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "nextcloud/coding-standard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\ChoreStrike\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\ChoreStrike\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": "phpunit --configuration phpunit.unit.xml",
        "test:coverage": "phpunit --configuration phpunit.unit.xml --coverage-clover build/coverage/phpunit-clover.xml --coverage-html build/coverage/phpunit-html"
    }
}
