{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run stylelint *)",
      "Bash(npm run build *)",
      "Bash(npm run test:noise *)",
      "Bash(npm run l10n:check-keys *)",
      "Bash(npm run docs:encoding *)",
      "Bash(npm run backlog:check *)",
      "Bash(npm run agents:check *)",
      "Bash(npm run agents:sync *)",
      "Bash(composer cs:check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(docker info *)",
      "Bash(docker ps *)",
      "Bash(docker compose -f docker/compose.test.yml ps *)",
      "Bash(docker compose -f docker/compose.test.yml logs *)",
      "Bash(docker compose -f docker/compose.test.yml exec -T nextcloud-test vendor/bin/phpunit *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run l10n:check-keys *)",
      "PowerShell(npm run agents:check *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(docker info *)",
      "PowerShell(docker ps *)",
      "PowerShell(docker compose -f docker/compose.test.yml exec -T nextcloud-test vendor/bin/phpunit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(docker compose * down -v *)",
      "PowerShell(docker compose * down -v *)"
    ]
  }
}
