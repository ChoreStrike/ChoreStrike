{
  "name": "chorestrike",
  "version": "0.8.0-alpha.1",
  "description": "Gamified household task management for Nextcloud",
  "license": "MIT",
  "author": "ChoreStrike Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChoreStrike/ChoreStrike.git"
  },
  "bugs": {
    "url": "https://github.com/ChoreStrike/ChoreStrike/issues"
  },
  "homepage": "https://github.com/ChoreStrike/ChoreStrike#readme",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "lint": "eslint --ext .js,.vue src && eslint --ext .ts tests/e2e",
    "lint:fix": "eslint --ext .js,.vue src --fix && eslint --ext .ts tests/e2e --fix",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "stylelint:fix": "stylelint src/**/*.vue src/**/*.scss src/**/*.css --fix",
    "test": "cross-env NODE_OPTIONS=\"--require ./tests/jest.setup.deprecations.js\" jest",
    "test:watch": "cross-env NODE_OPTIONS=\"--require ./tests/jest.setup.deprecations.js\" jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--require ./tests/jest.setup.deprecations.js\" jest --coverage",
    "test:noise": "node scripts/check-test-noise.js",
    "test:package:build": "node scripts/build-package.js",
    "test:package:smoke": "node scripts/run-package-smoke.js",
    "test:e2e:gate": "node scripts/run-e2e-gate.js",
    "test:runtime:validate": "node scripts/test-runtime.js validate",
    "test:runtime:check": "node scripts/test-runtime.js check",
    "test:runtime:canonical": "node scripts/test-runtime.js verify-canonical",
    "package:export": "node scripts/export-package.js",
    "l10n:check-keys": "node scripts/check-l10n-keys.js",
    "docs:encoding": "node scripts/check-docs-encoding.js",
    "backlog:check": "node scripts/check-backlog.js",
    "agents:sync": "node scripts/sync-agent-adapters.js",
    "agents:check": "node scripts/sync-agent-adapters.js --check"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.320",
    "@nextcloud/auth": "^2.4.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "~7.2.0",
    "@nextcloud/event-bus": "^3.3.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.5.0",
    "@playwright/test": "^1.58.2",
    "ajv": "^8.18.0",
    "canvas-confetti": "^1.9.4",
    "howler": "^2.2.4",
    "lucide-vue-next": "^0.474.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "pinia": "^3.0.4",
    "svg-inline-loader": "^0.8.2",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "^7.23.7",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.0",
    "@nextcloud/babel-config": "^1.0.0",
    "@nextcloud/browserslist-config": "^3.0.0",
    "@nextcloud/eslint-config": "^8.3.0",
    "@nextcloud/eslint-plugin": "^2.0.0",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^6.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@typescript-eslint/typescript-estree": "^8.56.1",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/vue3-jest": "^29.2.6",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.1",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.2.6",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.19.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "path-browserify": "^1.0.1",
    "postcss-html": "^1.8.1",
    "sass": "^1.69.7",
    "sass-loader": "^16.0.2",
    "style-loader": "^4.0.0",
    "stylelint": "^17.9.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^5.9.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "fast-uri@3": "^3.1.8",
    "brace-expansion@1": "^1.1.21",
    "minimatch@9": "^9.0.9",
    "@vue/eslint-config-typescript": {
      "@typescript-eslint/eslint-plugin": "^8.56.1",
      "@typescript-eslint/parser": "^8.56.1",
      "@typescript-eslint/typescript-estree": "^8.56.1"
    }
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^20.19.0",
    "npm": "^10.8.2"
  }
}
