<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>chorestrike</id>
    <name>ChoreStrike</name>
    <summary>Gamified household task management - keep your home clean together!</summary>
    <description><![CDATA[
ChoreStrike turns household chores into a fun, cooperative game.

**Features:**
- 🏠 Organize tasks by rooms and floors
- 📅 Smart scheduling with flexible planning options
- 🎮 Gamification: Coins, combos, streaks and medals
- 👥 Multi-user support with leaderboards
- 🏆 Weekly medals and household goals
- 🔥 Streak protection so you never lose progress on a busy day
- 🌍 Multilingual (German, English, more to come)
- 📊 Track progress with House Health and room cleanliness

Complete tasks, build streaks and keep your home tidy together. Perfect for families and roommates!
    ]]></description>

    <version>0.1.1</version>
    <licence>MIT</licence>
    <default_language>de</default_language>
    
    <author>ChoreStrike Contributors</author>
    
    <namespace>ChoreStrike</namespace>
    
    <category>organization</category>
    <category>games</category>
    
    <website>https://github.com/ChoreStrike/ChoreStrike</website>
    <bugs>https://github.com/ChoreStrike/ChoreStrike/issues</bugs>
    <repository type="git">https://github.com/ChoreStrike/ChoreStrike.git</repository>
    
    <dependencies>
        <nextcloud min-version="27" max-version="31"/>
        <php min-version="8.2" max-version="8.3"/>
    </dependencies>
    
    <navigations>
        <navigation>
            <name>ChoreStrike</name>
            <route>chorestrike.page.index</route>
            <icon>app.svg</icon>
        </navigation>
    </navigations>
    
    <commands>
        <command>OCA\ChoreStrike\Command\TestDataSeed</command>
        <command>OCA\ChoreStrike\Command\TriggerJobs</command>
    </commands>

    <!--
        Background jobs.

        The StreakFreeze/StreakRestock jobs retired with the WP3
        legacy-effect cutover (CS-PLAN-070, Q-074-01 Option A): dated
        recognized pauses are the neutral absence mechanism and the rhythm
        evaluator re-derives streaks from valid history.

        TimelineJob (CS-PLAN-072 WP1) runs at a five-minute cadence on the
        injected clock and advances the occurrence agreement frontier —
        never awards, credits or notifications. Late cron runs reconcile
        missed history from the immutable rule inputs; a stopped cron never
        forces a write on GET.
    -->
    <backgroundjobs>
        <job>OCA\ChoreStrike\BackgroundJob\DailyNotificationJob</job>
        <job>OCA\ChoreStrike\BackgroundJob\TimelineJob</job>
    </backgroundjobs>

    <!--
        The notifier is registered programmatically in
        lib/AppInfo/Application.php (registerNotifierService). The legacy
        <notifications> info.xml tag is not wired on modern Nextcloud and
        was removed (CS-PLAN-023).
    -->
</info>
