/coverage/
/.phpunit.result.cache
/.phpunit.integration.result.cache
/.php-cs-fixer.cache
/blob-report/
/playwright/.cache/
/.nyc_output/
/junit.xml

# Logs
*.log
/.playwright-mcp/
