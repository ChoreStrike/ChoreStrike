# Private/Local Development Files
/private/
/archive/
/docs/private/
.windsurfrules
*.local
.env
.env.local

# Composer installer artifacts (keep installed deps only)
composer-setup.php
composer.phar
fix-email.bat

# Composer dependencies (installed via `composer install`; lock file stays tracked)
/vendor/

# Local AI tooling state; only generated adapters (npm run agents:sync) and
# shared Claude settings are tracked. Canonical sources: docs/standards/ai/.
/.kilo/*
!/.kilo/command/
/.kilo/command/*
!/.kilo/command/*.md
/.claude/*
!/.claude/settings.json
!/.claude/skills/
!/.claude/commands/
!/.claude/agents/
# Machine-specific MCP servers (mirrors the local .kilo/kilo.jsonc "mcp" block)
/.mcp.json

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
/build/
/dist/
/js/
/css/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Nextcloud
/data/
/config/config.php
.sync-exclude.lst
*.sync-conflict-*

# Testing
# (Playwright output/report/auth artifacts live under /build/ — see
# playwright.config.ts; CS-PLAN-069 WP4.)
/coverage/
/.phpunit.result.cache
/.phpunit.integration.result.cache
/.php-cs-fixer.cache
/blob-report/
/playwright/.cache/
/.nyc_output/
/junit.xml

# Logs
*.log
/.playwright-mcp/
