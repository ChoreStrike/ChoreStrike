# Private/Local Development Files
/private/
/archive/
/docs/private/
.windsurfrules
*.local
.env
.env.local

# Composer installer artifacts (keep installed deps only)
composer-setup.php
composer.phar
fix-email.bat

# Composer dependencies (installed via `composer install`; lock file stays tracked)
/vendor/

# Local AI tooling state; only thin command adapters are tracked
/.kilo/*
!/.kilo/command/
/.kilo/command/*
!/.kilo/command/*.md

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
/build/
/dist/
/js/
/css/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Nextcloud
/data/
/config/config.php
.sync-exclude.lst
*.sync-conflict-*

# Testing
