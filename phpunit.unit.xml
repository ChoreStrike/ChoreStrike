<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
         bootstrap="tests/bootstrap-entity.php"
         cacheResultFile=".phpunit.result.cache"
         executionOrder="depends,defects"
         beStrictAboutCoversAnnotation="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTodoAnnotatedTests="true"
         failOnRisky="true"
         failOnWarning="true"
         verbose="true">
    <testsuites>
        <!-- Entity tests only (no Mapper dependencies) -->
        <testsuite name="Entity">
            <directory suffix="Test.php">tests/unit/Db</directory>
            <exclude>tests/unit/Db/HouseMapperTest.php</exclude>
            <exclude>tests/unit/Db/TaskMapperTest.php</exclude>
            <exclude>tests/unit/Db/FloorMapperTest.php</exclude>
            <exclude>tests/unit/Db/CompletedTaskMapperTest.php</exclude>
            <exclude>tests/unit/Db/HouseUserMapperTest.php</exclude>
            <exclude>tests/unit/Db/RoomMapperTest.php</exclude>
            <exclude>tests/unit/Db/RoomTaskMapperTest.php</exclude>
            <exclude>tests/unit/Db/MedalMapperTest.php</exclude>
        </testsuite>
        <!-- Mock-based mapper tests (CS-PLAN-022 D2: run in the no-DB CI gate) -->
        <testsuite name="Mapper">
            <file>tests/unit/Db/HouseMapperTest.php</file>
            <file>tests/unit/Db/TaskMapperTest.php</file>
            <file>tests/unit/Db/FloorMapperTest.php</file>
            <file>tests/unit/Db/CompletedTaskMapperTest.php</file>
            <file>tests/unit/Db/HouseUserMapperTest.php</file>
            <file>tests/unit/Db/RoomMapperTest.php</file>
            <file>tests/unit/Db/RoomTaskMapperTest.php</file>
            <file>tests/unit/Db/MedalMapperTest.php</file>
            <file>tests/unit/Db/TaskAssigneeMapperTest.php</file>
            <file>tests/unit/Db/TaskChecklistItemMapperTest.php</file>
            <file>tests/unit/Db/RoomTaskChecklistProgressMapperTest.php</file>
            <file>tests/unit/Db/MinigameScoreMapperTest.php</file>
            <file>tests/unit/Db/UserStatsMapperTest.php</file>
            <file>tests/unit/Db/AvailabilitySettingsMapperTest.php</file>
            <file>tests/unit/Db/ComboMapperTest.php</file>
        </testsuite>
        <!-- Service tests that don't require real database -->
        <testsuite name="Service">
            <directory>tests/unit/Service</directory>
        </testsuite>
        <!-- Background job tests (TimedJob subclasses; mocked DB) -->
        <testsuite name="BackgroundJob">
            <directory>tests/unit/BackgroundJob</directory>
        </testsuite>
        <!-- Notification renderer tests (INotifier implementation) -->
        <testsuite name="Notification">
            <directory>tests/unit/Notification</directory>
        </testsuite>
        <!-- Controller tests (CS-PLAN-020): now run in the CI unit gate -->
        <testsuite name="Controller">
            <directory suffix="Test.php">tests/unit/Controller</directory>
        </testsuite>
        <!-- Migration tests (CS-PLAN-020): changeSchema defect-class guard -->
        <testsuite name="Migration">
            <directory suffix="Test.php">tests/unit/Migration</directory>
        </testsuite>
        <!-- l10n tests (currently Jest-backed; no *Test.php files yet) -->
        <testsuite name="l10n">
            <directory suffix="Test.php">tests/unit/l10n</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="false">
        <include>
            <directory suffix=".php">lib</directory>
        </include>
    </coverage>
</phpunit>
