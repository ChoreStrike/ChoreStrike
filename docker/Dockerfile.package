# syntax=docker/dockerfile:1

# CS-PLAN-083 WP2: pinned, digest-verified package builder toolchain.
# Only the immutable toolchain lives in this image (Node/npm for the locked
# webpack production build, PHP 8.4 + Composer for the locked production
# autoloader); the actual build inputs are mounted read-only by
# scripts/build-package.js as a `git archive HEAD` tar, so a dirty
# workspace, ignored build outputs or host-OS path separators can never leak
# into a qualified package. Pin updates require re-running the two-build
# reproducibility proof.
ARG NODE_IMAGE=node:24.14.0@sha256:1698b8f453a36aa5b2545a0ab21b1781bef5c62a4626a2e8d2a01e7cde4fad45
ARG COMPOSER_IMAGE=composer:2.9.5@sha256:698d3801b2a622ace460c4743c781282fcbcb733a4cbf8b31c44731e846585e8
ARG PHP_IMAGE=php:8.4.25-apache@sha256:82256e3beb70749ba80a2bfdaa005e35dd446678cd136c45a9de94ccad27cd74

FROM ${NODE_IMAGE} AS node-tool
FROM ${COMPOSER_IMAGE} AS composer-tool

# The PHP runtime satisfies the app's locked composer.json platform contract
# (php ~8.4.0); production dependencies need no extra extensions.
FROM ${PHP_IMAGE}

# The Node toolchain ships in /usr/local (bin, lib/node_modules, include).
COPY --from=node-tool /usr/local/ /usr/local/
COPY --from=composer-tool /usr/bin/composer /usr/bin/composer

WORKDIR /package

# The runner executes (approximately):
#   git archive HEAD -> source.tar (mounted read-only at /inputs/source.tar)
#   docker run -v source.tar:/inputs/source.tar:ro -e SOURCE_DATE_EPOCH=<commit epoch> \
#     <builder> bash -c 'tar -xf /inputs/source.tar && npm ci && composer install --no-dev \
#       && npx webpack --mode production --json=/tmp/stats.json \
#       && tar -C /package -czf /tmp/out.tar.gz js vendor \
#       && cp /tmp/stats.json /tmp/'
# (A file mount replaces stdin piping: large stdin streams break spawnSync
# on Windows hosts.)
# Build outputs are streamed back on stdout; nothing host-side is trusted.
CMD ["bash", "-c", "echo 'Package builder toolchain only; drive via scripts/build-package.js' >&2; exit 1"]
