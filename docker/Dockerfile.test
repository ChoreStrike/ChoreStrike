# syntax=docker/dockerfile:1

# Use PHP 8.2 with Apache as base
FROM php:8.2-apache

# Install system dependencies and PHP extensions
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    curl \
    default-mysql-client \
    libzip-dev \
    libxml2-dev \
    libicu-dev \
    libonig-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libmagickwand-dev \
    libgmp-dev \
    libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
    zip \
    intl \
    mbstring \
    xml \
    curl \
    gd \
    gmp \
    pdo \
    pdo_mysql \
    pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

# Install PCOV for PHPUnit coverage (faster than Xdebug, CI-friendly)
RUN pecl install pcov && docker-php-ext-enable pcov \
    && echo "pcov.directory=/var/www/html/custom_apps/chorestrike/lib" > /usr/local/etc/php/conf.d/pcov.ini

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Nextcloud requires mod_rewrite for its front controller; without it,
# /apps/... URLs bypass index.php and non-GET API requests are misrouted.
# The custom vhost replaces the stock default site (see apache-nextcloud.conf).
COPY docker/apache-nextcloud.conf /etc/apache2/conf-available/nextcloud.conf
RUN a2enmod rewrite headers && a2enconf nextcloud && a2dissite 000-default

# Set up PHP configuration for testing
RUN echo "memory_limit=512M" > /usr/local/etc/php/conf.d/memory.ini
RUN echo "error_reporting=E_ALL" > /usr/local/etc/php/conf.d/error_reporting.ini

# Clone Nextcloud Server stable31 branch (compatible with NC 31+ / Vue 3 stack)
RUN git clone --depth 1 --branch stable31 https://github.com/nextcloud/server.git /var/www/html

# Initialize required Nextcloud submodules (notably 3rdparty)
RUN git config --global --add safe.directory /var/www/html \
    && cd /var/www/html \
    && git submodule update --init --recursive

# Set up directory structure
RUN mkdir -p /var/www/html/custom_apps/chorestrike

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html

WORKDIR /var/www/html/custom_apps/chorestrike

# Default command keeps container alive
CMD ["tail", "-f", "/dev/null"]
