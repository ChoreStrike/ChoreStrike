# syntax=docker/dockerfile:1

# Existing defaults stay unchanged until candidate qualification/promotion.
ARG PHP_IMAGE=php:8.2-apache
ARG COMPOSER_IMAGE=composer:latest
FROM ${COMPOSER_IMAGE} AS composer-tool
FROM ${PHP_IMAGE}

ARG NEXTCLOUD_REF=stable31
ARG NEXTCLOUD_REVISION
ARG NOTIFICATIONS_REF=stable31
ARG NOTIFICATIONS_REVISION
ARG PCOV_VERSION=1.0.12
ARG APCU_VERSION=5.1.24
ARG RUNTIME_INVENTORY_SHA256
LABEL org.chorestrike.test-runtime.inventory=${RUNTIME_INVENTORY_SHA256}

# Install system dependencies and PHP extensions
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    curl \
    default-mysql-client \
    libzip-dev \
    libxml2-dev \
    libicu-dev \
    libonig-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libmagickwand-dev \
    libgmp-dev \
    libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && extensions="$(php -r 'foreach (array_slice($argv, 1) as $extension) { if (!extension_loaded($extension)) { echo $extension . " "; } }' \
    zip \
    intl \
    mbstring \
    xml \
    curl \
    gd \
    gmp \
    pdo \
    pdo_mysql \
    pdo_pgsql \
    pcntl)" \
    && if [ -n "$extensions" ]; then docker-php-ext-install $extensions; fi \
    && rm -rf /var/lib/apt/lists/*

# Install PCOV for PHPUnit coverage (faster than Xdebug, CI-friendly)
RUN pecl install pcov-${PCOV_VERSION} && docker-php-ext-enable pcov \
    && echo "pcov.directory=/var/www/html/custom_apps/chorestrike/lib" > /usr/local/etc/php/conf.d/pcov.ini

# Native Nextcloud UserRateLimit needs counters shared across HTTP requests.
RUN pecl install apcu-${APCU_VERSION} && docker-php-ext-enable apcu \
    && echo "apc.enable_cli=1" > /usr/local/etc/php/conf.d/apcu-cli.ini

# Install Composer
COPY --from=composer-tool /usr/bin/composer /usr/bin/composer

# Nextcloud requires mod_rewrite for its front controller; without it,
# /apps/... URLs bypass index.php and non-GET API requests are misrouted.
# The custom vhost replaces the stock default site (see apache-nextcloud.conf).
COPY docker/apache-nextcloud.conf /etc/apache2/conf-available/nextcloud.conf
RUN a2enmod rewrite headers && a2enconf nextcloud && a2dissite 000-default

# Set up PHP configuration for testing
RUN echo "memory_limit=512M" > /usr/local/etc/php/conf.d/memory.ini
RUN echo "error_reporting=E_ALL" > /usr/local/etc/php/conf.d/error_reporting.ini

# Candidate builds verify immutable source identity, not just the tag name.
RUN git clone --depth 1 --branch "${NEXTCLOUD_REF}" https://github.com/nextcloud/server.git /var/www/html \
    && git config --global --add safe.directory /var/www/html \
    && if [ -n "${NEXTCLOUD_REVISION}" ]; then \
        test "$(git -C /var/www/html rev-parse HEAD)" = "${NEXTCLOUD_REVISION}"; \
    fi

# Initialize required Nextcloud submodules (notably 3rdparty)
RUN cd /var/www/html \
    && git submodule update --init --recursive

# The `notifications` app ships in Nextcloud release tarballs but NOT in the
# server git clone; the E2E bell assertions (CS-PLAN-023 at-risk notification
# flow) need it. Candidate builds pin it alongside the server revision.
RUN git clone --depth 1 --branch "${NOTIFICATIONS_REF}" https://github.com/nextcloud/notifications.git /var/www/html/apps/notifications \
    && git config --global --add safe.directory /var/www/html/apps/notifications \
    && if [ -n "${NOTIFICATIONS_REVISION}" ]; then \
        test "$(git -C /var/www/html/apps/notifications rev-parse HEAD)" = "${NOTIFICATIONS_REVISION}"; \
    fi

# Set up directory structure
RUN cd /var/www/html/apps/notifications \
    && composer install --no-dev --no-interaction --prefer-dist \
    && composer check-platform-reqs --no-dev

# The source tag ships JS, but runtime vendor/autoload and Mozart's namespaced
# PHP dependencies are generated by the upstream production Composer hooks.
RUN mkdir -p /var/www/html/custom_apps/chorestrike /var/www/html/data

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html

WORKDIR /var/www/html/custom_apps/chorestrike

# Default command keeps container alive
CMD ["tail", "-f", "/dev/null"]
